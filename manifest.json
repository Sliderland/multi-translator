{
  "manifest_version": 3,
  "name": "Multi Translator",
  "version": "0.2.0",
  "description": "Translate webpages in place and selected text with LibreTranslate or DeepL.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Translate",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
