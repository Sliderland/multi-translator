{
  "manifest_version": 3,
  "name": "Multi Translator",
  "version": "0.1.0",
  "description": "Translate webpages and selected text using Google Translate or LibreTranslate.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Translate",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
